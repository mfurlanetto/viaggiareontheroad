# Copia questo file in .env (ignorato da git) e compila i valori.
# Dashboard Supabase > Project Settings > API Keys

VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Chiave pubblica (publishable key, formato sb_publishable_...). Va bene nel
# browser perche' i dati sono protetti dalla RLS: vedi docs/supabase-rls.sql.
# Le vecchie chiavi JWT "anon" del progetto sono disattivate e non sono supportate.
VITE_SUPABASE_PUBLISHABLE_KEY=
