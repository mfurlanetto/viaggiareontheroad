# Copia questo file in .env (ignorato da git) e compila i valori.
# Dashboard Supabase > Project Settings > API Keys

VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Chiave pubblica (publishable key). Va bene nel browser SOLO se la RLS e' attiva
# su tutte le tabelle: vedi docs/supabase-rls.sql.
VITE_SUPABASE_PUBLISHABLE_KEY=
# In alternativa, la vecchia chiave anon (in dismissione):
# VITE_SUPABASE_ANON_KEY=
